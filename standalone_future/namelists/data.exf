 vwind_lat0        = -90.00D0,
 vwind_lat_inc     = 144*1.25,
 vwind_nlon        = 192,
 vwind_nlat        = 145,
#
 swdown_lon0        =   0.0D0
 swdown_lon_inc     =   1.875D0,
 swdown_lat0        = -90.00D0,
 swdown_lat_inc     = 144*1.25,
 swdown_nlon        = 192,
