# *********************
# External Forcing Data
# *********************
# ACCESS ESM 1.5  
 &EXF_NML_01
 useExfYearlyFields = .TRUE., 
 useExfCheckRange   = .FALSE.,
 exf_iprec          = 64,
 exf_yftype         = 'RL',
 diags_opOceWeighted= .FALSE.,
 useAtmWind        = .TRUE.,
#  
# TO COMBINE WITH ALLOW_ZENITH_ANGLE:
 exf_albedo        = 0.1,
 useExfZenIncoming = .TRUE., 
 select_ZenAlbedo  = 1,
#
 ocean_emissivity = 0.97,
 ice_emissivity   = 0.95,
 snow_emissivity  = 0.95,
# 
 exf_scal_BulkCdn=1.,

 &
#
 &EXF_NML_02
#
 atempstartdate1   = 20750101,
 atempstartdate2   = 00000,
 atempperiod       = 21600.0,
#
 aqhstartdate1     = 20750101,
 aqhstartdate2     = 00000,
 aqhperiod         = 86400.0,
#
 precipstartdate1  = 20750101,
 precipstartdate2  = 00000,
 precipperiod      = 86400.0,
#
 uwindstartdate1   = 20750101,
 uwindstartdate2   = 00000,
 uwindperiod       = 21600.0,
#
 vwindstartdate1   = 20750101,
 vwindstartdate2   = 00000,
 vwindperiod       = 21600.0,
#
# runoffstartdate1 = 20750101,
# runoffstartdate2 = 060000, 
# runoffperiod = -12,
#   
 swdownstartdate1  = 20750101,
 swdownstartdate2  = 00000,
 swdownperiod      = 86400.0,
#
 lwdownstartdate1  = 20750101,
 lwdownstartdate2  = 00000,
 lwdownperiod      = 86400.0,
#
#
 atempfile         = 'ACCESS-ESM_t2m',
 aqhfile           = 'ACCESS-ESM_huss',
 precipfile        = 'ACCESS-ESM_tp',
 uwindfile         = 'ACCESS-ESM_u10',
 vwindfile         = 'ACCESS-ESM_v10',
 swdownfile        = 'ACCESS-ESM_sw',
 lwdownfile        = 'ACCESS-ESM_lw',
# runofffile = 'run-off-64.bin_1x1',
#
 &
 &EXF_NML_03
# access in kg/m2/s -> :1000kg/m3 (density) to make ot m/s
 exf_inscal_precip=0.001,
 &
#
 &EXF_NML_04
# 
