 precip_lon_inc     =  1.875D0,
 precip_lat0        = -90.00D0,
 precip_lat_inc     =144*1.25,
 precip_nlon        = 192,
 precip_nlat        = 145,
#
 uwind_lon0        =   0.0D0
 uwind_lon_inc     =   1.875D0,
 uwind_lat0        = -90.00D0,
 uwind_lat_inc     = 144*1.25,
 uwind_nlon        = 192,
 uwind_nlat        = 145,
#
