# Age Tracer set-up: No initial file means Age Tracer
# is automatically initialized uniformely to zero. 
 &PTRACERS_PARM01
 PTRACERS_numInUse=2,
 PTRACERS_diffKr=1.E-5,
 PTRACERS_diffKh=0.E3,
 PTRACERS_names(1)='age_trc',
 PTRACERS_units(1)='y',
# Ptracers_initialFile(1)='zero.bin',
 PTRACERS_names(2)='melt_trc',
# Ptracers_initialFile(2)='zero.bin',
# PTRACERS_units(2)='y', 
# PTRACERS_names(3)='cdw_trc',
# PTRACERS_units(3)='1', 
 &
