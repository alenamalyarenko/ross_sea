# runoff_lon0        = 0.50D0,
# runoff_lon_inc     = 1.0D0,
# runoff_lat0        = -79.5D0,
# runoff_lat_inc     = 160*1.0D0,
# runoff_nlon        = 360,
# runoff_nlat        = 160,
#
 &
